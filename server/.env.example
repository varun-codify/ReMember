# Copy this file to .env and fill in real values.
# In production, JWT_SECRET, ENCRYPTION_KEY and MONGODB_URI are required —
# the server refuses to start without them.

PORT=5000
MONGODB_URI=mongodb://localhost:27017/remember
JWT_SECRET=change_me_to_a_long_random_string
ENCRYPTION_KEY=change_me_to_another_long_random_string
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Optional: used for YouTube metadata (the app falls back to page scraping)
YOUTUBE_API_KEY=
