# Copy values from server/.env (local Express) and paste them into
# Vercel Dashboard → Settings → Environment Variables for production.
# NEVER commit real secrets — this file uses placeholders only.

# Required in production (server refuses to start without them)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/remember?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
ENCRYPTION_KEY=change_me_to_another_long_random_string
NODE_ENV=production

# Frontend
REACT_APP_API_URL=/api
CLIENT_URL=https://your-vercel-app.vercel.app
PORT=5000

# Optional: used for YouTube metadata (app falls back to page scraping)
YOUTUBE_API_KEY=

# Optional integrations (leave empty if not using)
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@remember.app
# RESEND_API_KEY=
# EMAIL_FROM=ReMember <onboarding@resend.dev>
# APP_URL=https://your-vercel-app.vercel.app
# CRON_SECRET=
